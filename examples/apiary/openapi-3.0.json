{
  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "Harvest": {
        "properties": {
          "beekeeper": {
            "description": "Who harvested",
            "example": "beekeeper",
            "type": "string"
          },
          "harvestedAt": {
            "description": "When the honey was taken",
            "format": "date-time",
            "type": "string"
          },
          "hiveId": {
            "description": "Hive the honey was taken from",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "kg": {
            "description": "Honey taken, kg",
            "example": 4.5,
            "format": "double",
            "type": "number"
          },
          "remainingKg": {
            "description": "Honey left in the hive, kg",
            "example": 8,
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "hiveId",
          "kg",
          "remainingKg",
          "harvestedAt",
          "beekeeper"
        ],
        "type": "object"
      },
      "Hive": {
        "properties": {
          "bees": {
            "description": "Number of bees living in the hive",
            "example": 42000,
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "description": "When the hive was set up",
            "format": "date-time",
            "type": "string"
          },
          "honeyKg": {
            "description": "Honey stored in the hive, kg",
            "example": 12.5,
            "format": "double",
            "type": "number"
          },
          "id": {
            "description": "Hive ID",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "location": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Location"
              }
            ],
            "description": "Where the hive stands"
          },
          "name": {
            "description": "Name painted on the hive",
            "example": "Linden",
            "type": "string"
          },
          "queen": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Queen"
              }
            ],
            "description": "Queen of the colony, if there is one"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HiveStatus"
              }
            ],
            "description": "Colony state"
          },
          "tags": {
            "description": "Free-form labels",
            "example": [
              "meadow",
              "calm"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "bees",
          "honeyKg",
          "location",
          "tags",
          "createdAt"
        ],
        "type": "object"
      },
      "HiveStatus": {
        "enum": [
          "active",
          "swarming",
          "dormant",
          "empty"
        ],
        "type": "string"
      },
      "HiveUpdate": {
        "properties": {
          "name": {
            "description": "New name",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "queen": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Queen"
              }
            ],
            "description": "New queen"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HiveStatus"
              }
            ],
            "description": "New colony state"
          }
        },
        "type": "object"
      },
      "Location": {
        "properties": {
          "lat": {
            "description": "Latitude",
            "example": 55.75,
            "format": "double",
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "lon": {
            "description": "Longitude",
            "example": 37.62,
            "format": "double",
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object"
      },
      "NewHive": {
        "properties": {
          "location": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Location"
              }
            ],
            "description": "Where the hive stands"
          },
          "name": {
            "description": "Name painted on the hive",
            "example": "Linden",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HiveStatus"
              }
            ],
            "default": "empty",
            "description": "Initial colony state"
          },
          "tags": {
            "description": "Free-form labels",
            "items": {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "location"
        ],
        "type": "object"
      },
      "PageHive": {
        "properties": {
          "items": {
            "description": "Items on this page",
            "items": {
              "$ref": "#/components/schemas/Hive"
            },
            "type": "array"
          },
          "limit": {
            "description": "Page size",
            "example": 20,
            "format": "int64",
            "type": "integer"
          },
          "offset": {
            "description": "Items skipped",
            "example": 0,
            "format": "int64",
            "type": "integer"
          },
          "total": {
            "description": "Number of items in all pages",
            "example": 3,
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "Problem details, RFC 9457.",
        "properties": {
          "detail": {
            "example": "request validation failed",
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "location": {
                  "example": "body.name",
                  "type": "string"
                },
                "message": {
                  "example": "is required",
                  "type": "string"
                }
              },
              "required": [
                "location",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "example": 422,
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "example": "Unprocessable Entity",
            "type": "string"
          },
          "type": {
            "example": "about:blank",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "Queen": {
        "properties": {
          "bornOn": {
            "description": "Date the queen hatched",
            "example": "2026-05-14",
            "format": "date",
            "type": "string"
          },
          "breed": {
            "description": "Bee breed",
            "enum": [
              "carniolan",
              "italian",
              "buckfast"
            ],
            "example": "carniolan",
            "type": "string"
          }
        },
        "required": [
          "breed",
          "bornOn"
        ],
        "type": "object"
      },
      "Stats": {
        "properties": {
          "bees": {
            "description": "Bees in all hives",
            "example": 97000,
            "format": "int64",
            "type": "integer"
          },
          "hives": {
            "description": "Number of hives",
            "example": 3,
            "format": "int64",
            "type": "integer"
          },
          "honeyKg": {
            "description": "Honey in all hives, kg",
            "example": 31.5,
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "hives",
          "bees",
          "honeyKg"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "beekeeper": {
        "description": "Beekeeper token. The demo token is `beekeeper`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Manage beehives: count bees, move colonies and harvest honey. An example of swaggerkit.",
    "license": {
      "name": "MIT"
    },
    "title": "Apiary API",
    "version": "1.0.0"
  },
  "paths": {
    "/hives": {
      "get": {
        "operationId": "listHives",
        "parameters": [
          {
            "description": "Page size",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items to skip",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Only hives in this state",
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/HiveStatus"
            }
          },
          {
            "description": "Only hives with all of these tags",
            "in": "query",
            "name": "tag",
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageHive"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List hives",
        "tags": [
          "hives"
        ]
      },
      "post": {
        "operationId": "createHive",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewHive"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hive"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "beekeeper": []
          }
        ],
        "summary": "Create hive",
        "tags": [
          "hives"
        ]
      }
    },
    "/hives/{hiveId}": {
      "delete": {
        "operationId": "deleteHive",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "beekeeper": []
          }
        ],
        "summary": "Delete hive",
        "tags": [
          "hives"
        ]
      },
      "get": {
        "operationId": "getHive",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hive"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get hive",
        "tags": [
          "hives"
        ]
      },
      "patch": {
        "operationId": "updateHive",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HiveUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hive"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "beekeeper": []
          }
        ],
        "summary": "Update hive",
        "tags": [
          "hives"
        ]
      }
    },
    "/hives/{hiveId}/bees": {
      "post": {
        "operationId": "addBees",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "count": {
                    "description": "Number of bees to add",
                    "example": 5000,
                    "format": "int64",
                    "maximum": 50000,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "count"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hive"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "beekeeper": []
          }
        ],
        "summary": "Move bees into a hive",
        "tags": [
          "hives"
        ]
      }
    },
    "/hives/{hiveId}/harvests": {
      "post": {
        "operationId": "harvestHoney",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "kg": {
                    "description": "Honey to take, kg",
                    "example": 4.5,
                    "exclusiveMinimum": true,
                    "format": "double",
                    "maximum": 100,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "kg"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Harvest"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "beekeeper": []
          }
        ],
        "summary": "Harvest honey",
        "tags": [
          "hives",
          "honey"
        ]
      }
    },
    "/hives/{hiveId}/label": {
      "get": {
        "operationId": "hiveLabel",
        "parameters": [
          {
            "description": "Hive ID",
            "in": "path",
            "name": "hiveId",
            "required": true,
            "schema": {
              "example": 1,
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Print a hive label",
        "tags": [
          "hives"
        ]
      }
    },
    "/stats": {
      "get": {
        "operationId": "getStats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Count hives, bees and honey",
        "tags": [
          "apiary"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "description": "Beehives and their colonies",
      "name": "hives"
    },
    {
      "description": "Honey harvests",
      "name": "honey"
    },
    {
      "description": "The apiary as a whole",
      "name": "apiary"
    }
  ]
}
